# LLM Provider
OPENAI_API_KEY=
PEHD_LLM_USAGE_DIR=/data/llm_usage

# Supabase (ledger of record) — project URL + service-role key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Google Sheets (optional: nightly export + audit fallback)
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
GSPREAD_SPREADSHEET_ID=

# Webhook security (shared secret between Apps Script and Hermes)
WEBHOOK_HMAC_SECRET=

# Telegram (get from @BotFather and @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
