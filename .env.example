# Every variable the container reads. Set these in the Render dashboard
# (render.yaml declares all nine; only PEHD_LLM_USAGE_DIR carries a value
# there, the rest are `sync: false` and typed in by hand). This file exists
# so you can see the full list in one place and for local runs of the
# scripts under scripts/.

# --- Required -------------------------------------------------------------

# The model and speech-to-text. hermes-config/cli-config.yaml points at
# api.openai.com/v1; any OpenAI-compatible endpoint works (see SETUP,
# "Swapping the pieces").
OPENAI_API_KEY=

# Supabase: the ledger of record. Project URL + the SECRET (service_role)
# key. Every tool is gated on this pair being set.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Shared secret between the Gmail Apps Script and the webhook. NOT optional:
# unset, the published placeholder string becomes your signing key and
# anyone who reads this repo can write to your ledger.
#   openssl rand -hex 32
WEBHOOK_HMAC_SECRET=

# Telegram. Token from @BotFather; your NUMERIC user id from @userinfobot.
# TELEGRAM_ALLOWED_USERS also becomes the cron delivery target.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# --- Has a default ----------------------------------------------------------

# Where the per-call LLM usage log (JSONL) is written on the persistent disk.
PEHD_LLM_USAGE_DIR=/data/llm_usage

# --- Optional: Google Sheet backup only (SETUP section 8) -------------------

# Leave both unset and the two export tools stay quiet; nothing else changes.
# On Render, GOOGLE_SERVICE_ACCOUNT_JSON is the ENTIRE contents of the
# service-account JSON file; start.sh writes it to /data/service-account.json.
# Locally it can be a path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GSPREAD_SPREADSHEET_ID=
